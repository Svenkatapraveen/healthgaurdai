rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAssignedDoctor(doctorId) {
      return isSignedIn() && (request.auth.uid == doctorId || request.auth.token.email.matches('.*@healthguard\\.ai'));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Doctors Collection
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isAssignedDoctor(doctorId);
    }

    // Assessments Collection
    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn();
    }

    // Appointments Collection (Doctor-wise & Patient Data Protection)
    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }

    // Consultations Collection
    match /consultations/{consultationId} {
      allow read, write: if isSignedIn();
    }

    // Notifications & Reminders
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == 'admin' && isAdmin()) ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn();
    }
  }
}
