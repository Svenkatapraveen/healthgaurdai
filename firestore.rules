rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAssignedDoctor(doctorId) {
      return isSignedIn() && (request.auth.uid == doctorId || request.auth.token.email.matches('.*@healthguard\\.ai'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Doctors Collection
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isAssignedDoctor(doctorId);
    }

    // Assessments Collection
    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn();
    }

    // Appointments Collection (Doctor-wise & Patient Data Protection)
    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }

    // Consultations Collection
    match /consultations/{consultationId} {
      allow read, write: if isSignedIn();
    }

    // Notifications & Reminders
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn();
    }
  }
}
